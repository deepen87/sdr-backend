# Backend config
HOST=0.0.0.0
PORT=8000
DATA_FILE=key_store.dat

# LLM config
# Your API key for the LLM provider (OpenAI, OpenRouter, Anthropic, etc.)
LLM_API_KEY=your-api-key-here
# Base URL for the OpenAI-compatible API endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model name to use (e.g. gpt-4o-mini, claude-haiku-20240307)
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

